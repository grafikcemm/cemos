generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel/AWS Lambda runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(cuid())
  handle    String   @unique
  xHandle   String
  persona   String
  concept   String
  maxChars  Int
  // Platform attribution (CemOS çok-platform temeli): "x" | "instagram" | "youtube"
  platform  String   @default("x")
  createdAt DateTime @default(now())

  styleProfile         StyleProfile?
  sources              Source[]
  sourcePosts          SourcePost[]
  queueItems           QueueItem[]
  schedule             Schedule?
  scanRuns             ScanRun[]
  generationRuns       GenerationRun[]
  usageLogs            UsageLog[]
  publishLogs          PublishLog[]
  viralPatterns        ViralPattern[]
  trainingExamples     TrainingExample[]
  feedbackEvents       FeedbackEvent[]
  evalTests            EvalTest[]
  contentOpportunities ContentOpportunity[]
}

model StyleProfile {
  id             String   @id @default(cuid())
  accountId      String   @unique
  account        Account  @relation(fields: [accountId], references: [id])
  toneRules      String
  formatRules    String
  forbiddenRules String
  modes          String
  updatedAt      DateTime @updatedAt
}

model Source {
  id                        String    @id @default(cuid())
  accountId                 String
  account                   Account   @relation(fields: [accountId], references: [id])
  handle                    String
  displayName               String?
  enabled                   Boolean   @default(true)
  mode                      String    @default("TWEET")
  thresholdLikes            Int       @default(10)
  thresholdRetweets         Int       @default(2)
  archivedAt                DateTime?
  createdAt                 DateTime  @default(now())
  socialDataUserId          String?
  socialDataUserIdUpdatedAt DateTime?

  sourcePosts SourcePost[]

  @@unique([accountId, handle])
}

model SourcePost {
  id               String    @id @default(cuid())
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id])
  sourceId         String
  source           Source    @relation(fields: [sourceId], references: [id])
  // Universal dedup key. For X this is the raw tweet id (back-compat); for
  // other platforms it is "<sourceType>:<rawId>" so one column dedupes all.
  tweetId          String    @unique
  // Multi-source discovery fields (Phase 1).
  sourceType       String    @default("x") // x | reddit | youtube | rss
  externalId       String? // raw platform id, before the sourceType prefix
  sourceWeight     Float     @default(0.9) // örn1 source weighting for ranking
  engagementScore  Int       @default(0) // normalized cross-platform engagement
  author           String? // original author / channel / subreddit
  lang             String? // en | tr | ...
  text             String
  likeCount        Int       @default(0)
  retweetCount     Int       @default(0)
  viewCount        Int       @default(0)
  viralScore       Int       @default(0)
  url              String
  publishedAt      DateTime?
  opportunityScore Float     @default(0)
  status           String    @default("new")
  // JSON array of source media URLs (images/videos) for visual content reuse.
  mediaUrls        String    @default("[]")
  scannedAt        DateTime  @default(now())

  queueItems QueueItem[]
}

model QueueItem {
  id                String      @id @default(cuid())
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id])
  sourcePostId      String?
  sourcePost        SourcePost? @relation(fields: [sourcePostId], references: [id])
  content           String
  editedContent     String?
  draftType         String      @default("TWEET")
  mode              String      @default("ai_news")
  status            String      @default("new")
  scheduledAt       DateTime?
  publishedAt       DateTime?
  estimatedCostUsd  Float       @default(0)
  usedMock          Boolean     @default(false)
  scores            String      @default("{}")
  lintReport        String?
  candidatesJson    String      @default("[]")
  lastError         String?
  approvedAt        DateTime?
  // News→draft bridge: which NewsItem this draft was grounded on (if any).
  newsItemId        String?
  newsItem          NewsItem?   @relation(fields: [newsItemId], references: [id])
  // Visual content: carried-over source image and/or AI-generated image.
  imageUrl          String?
  generatedImageUrl String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  generationRun GenerationRun?
}

model Schedule {
  id                String    @id @default(cuid())
  accountId         String    @unique
  account           Account   @relation(fields: [accountId], references: [id])
  cadence           String    @default("daily")
  lastScanAt        DateTime?
  automationEnabled Boolean   @default(false)
  scanCron          String    @default("0 9 * * *")
  dailyMaxPosts     Int       @default(3)
  quietStartHour    Int       @default(23)
  quietEndHour      Int       @default(8)
  calendarStrategy  String    @default("manual")
  lastPublishAt     DateTime?
  requireApproval   Boolean   @default(true)
  updatedAt         DateTime  @updatedAt
}

model ScanRun {
  id               String    @id @default(cuid())
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id])
  sourcesScanned   Int       @default(0)
  tweetsFound      Int       @default(0)
  postsInserted    Int       @default(0)
  estimatedCostUsd Float     @default(0)
  errors           String    @default("[]")
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
}

model GenerationRun {
  id               String    @id @default(cuid())
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id])
  queueItemId      String    @unique
  queueItem        QueueItem @relation(fields: [queueItemId], references: [id])
  modelUsed        String
  estimatedCostUsd Float     @default(0)
  usedMock         Boolean   @default(false)
  createdAt        DateTime  @default(now())
}

model UsageLog {
  id               String   @id @default(cuid())
  accountId        String?
  account          Account? @relation(fields: [accountId], references: [id])
  type             String
  tweetCount       Int?
  estimatedCostUsd Float    @default(0)
  // Real cost attribution: provider ("openrouter"|"socialdata"|"fal"), the model
  // used, and a JSON meta blob ({ purpose: "news_translate"|"draft_writer"|... }).
  provider         String?
  model            String?
  meta             String   @default("{}")
  platform         String   @default("x")
  date             String
  createdAt        DateTime @default(now())
}

model PublishLog {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])
  content      String
  publishedAt  DateTime  @default(now())
  platform     String    @default("x")
  externalId   String?
  scheduledAt  DateTime?
  success      Boolean   @default(true)
  errorMessage String?
  payload      String    @default("{}")
  createdAt    DateTime  @default(now())
}

// Growth Intelligence Engine models

model ViralPattern {
  id                   String   @id @default(cuid())
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id])
  patternName          String
  category             String?
  hookType             String?
  structureJson        String   @default("{}")
  emotion              String   @default("")
  viralityTrigger      String   @default("")
  exampleGood          String   @default("")
  exampleBad           String   @default("")
  usageCount           Int      @default(0)
  successScore         Int      @default(50)
  isActive             Boolean  @default(true)
  // örn1 deep-analysis dimensions (Phase 2 viral mining).
  trendingPotential    Int      @default(0)
  audienceInterest     Int      @default(0)
  newsValue            Int      @default(0)
  angleSuggestionsJson String   @default("[]")
  sourcePostId         String? // provenance: which external item this was mined from
  sourceType           String? // x | reddit | youtube | rss
  platform             String   @default("x") // owning platform (Faz F): x | instagram | youtube
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([platform])
}

model TrainingExample {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  inputType     String
  sourceContent String?
  outputContent String
  label         String
  reason        String   @default("")
  metricsJson   String   @default("{}")
  embeddingJson String?
  platform      String   @default("x")
  // Sprint 4 (CONTENT-ENGINE §5.1): seri-bazlı few-shot havuzu (additive).
  seriesKey     String?
  createdAt     DateTime @default(now())

  @@index([platform])
  @@index([seriesKey])
}

model FeedbackEvent {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  queueItemId     String?
  sourcePostId    String?
  feedbackType    String
  originalContent String?
  editedContent   String   @default("")
  reason          String   @default("")
  platform        String   @default("x")
  createdAt       DateTime @default(now())
}

model EvalTest {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])
  testName         String
  sourceContent    String?
  expectedBehavior String?
  generatedOutput  String   @default("")
  score            Float?
  failureReason    String?
  platform         String   @default("x")
  pipelineId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([platform])
}

// Faz G — traceable subagent tree. One row per generation pipeline run; the
// stagesJson holds [{stage,role,model,ok,failOpenUsed,ms,costUsd,score?}]. Trace
// writes are best-effort (never block production); pruned after 30 days.
model PipelineTrace {
  id           String   @id @default(cuid())
  platform     String   @default("x")
  pipelineId   String
  subjectType  String
  subjectId    String
  stagesJson   String   @default("[]")
  totalCostUsd Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@index([createdAt])
}

// Serverless cron/scan heartbeat + result log. Written heartbeat-first so even
// a timed-out invocation leaves proof the cron fired; doubles as the advisory
// lock for manual scans on Vercel (no shared filesystem there).
model CronRun {
  id         String    @id @default(cuid())
  kind       String // "daily" | "learn" | "manual_scan"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  partial    Boolean   @default(false)
  resultJson String    @default("{}")
  error      String?

  @@index([startedAt])
  @@index([kind, startedAt])
}

// ── News AI subsystem (ported from grafikcem-news-ai, Supabase → Prisma) ──

// RSS / Hacker News / GitHub Trending source registry with health tracking.
model NewsSource {
  id               String    @id @default(cuid())
  name             String
  url              String    @default("")
  feedUrl          String    @unique
  sourceType       String    @default("rss") // rss | hackernews | github_trending
  category         String    @default("ai")
  priority         Int       @default(50)
  reliability      String    @default("medium")
  enabled          Boolean   @default(true)
  fetchIntervalMin Int       @default(1440)
  errorCount       Int       @default(0)
  lastError        String?
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  createdAt        DateTime  @default(now())

  newsItems NewsItem[]
}

// Fetched + translated + scored news. The "news pool". Global (not account-scoped).
model NewsItem {
  id                 String      @id @default(cuid())
  newsSourceId       String?
  newsSource         NewsSource? @relation(fields: [newsSourceId], references: [id])
  url                String      @unique
  canonicalUrl       String?
  originalTitle      String
  trTitle            String?
  originalSummary    String?
  trSummary          String?
  category           String      @default("ai")
  tags               String      @default("[]")
  lang               String?
  imageUrl           String?
  viralScore         Int?
  xValueScore        Int?
  // "Çok konuşulan" ekseni — viral/xValue tweet potansiyeli ölçer; buzz dünya
  // gündemini ölçer: çapraz-kaynak teyidi + tazelik + dış popülerlik (HN/Reddit).
  buzzScore          Int?
  hnPoints           Int?
  hnComments         Int?
  redditScore        Int?
  externalSignalsAt  DateTime?
  whyPeopleCare      String?
  tweetAngle         String?
  suggestedFormat    String? // micro | punch | spark | storm | thread
  // single_source | official_only | editorial_confirmed | multi_source_confirmed
  sourceVerification String?
  processingStatus   String      @default("raw") // raw | translated | analyzed | low_score | failed | quarantined
  translationStatus  String      @default("pending")
  analysisStatus     String      @default("pending")
  modelUsed          String?
  errorMessage       String?
  isRead             Boolean     @default(false)
  isUsed             Boolean     @default(false)
  publishedAt        DateTime?
  fetchedAt          DateTime    @default(now())
  lastAttemptedAt    DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  queueItems    QueueItem[]
  opportunities ContentOpportunity[]

  @@index([processingStatus])
  @@index([viralScore])
  @@index([buzzScore])
  @@index([fetchedAt])
}

// AI-scored content opportunities (per-account targeting).
model ContentOpportunity {
  id              String    @id @default(cuid())
  newsItemId      String?
  newsItem        NewsItem? @relation(fields: [newsItemId], references: [id])
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id])
  sourceType      String    @default("news") // news | tool | repo | ai_tip
  turkishTitle    String
  oneLineValue    String    @default("")
  tweetAngle      String    @default("")
  contentFormat   String    @default("punch")
  xValueScore     Int       @default(0)
  noveltyScore    Int       @default(0)
  usefulnessScore Int       @default(0)
  visualScore     Int       @default(0)
  status          String    @default("new")
  createdAt       DateTime  @default(now())

  @@index([status])
}

// Trending GitHub repos (labelled "GitHub Trending"; fetched via GitHub search API).
model RepoRadarItem {
  id            String    @id @default(cuid())
  repoName      String
  owner         String
  repoUrl       String    @unique
  stars         Int       @default(0)
  forks         Int       @default(0)
  language      String?
  topics        String    @default("[]")
  descriptionTr String    @default("")
  whyItMatters  String    @default("")
  bestFor       String?
  tweetHook     String    @default("")
  xValueScore   Int       @default(0)
  lastCommitAt  DateTime?
  status        String    @default("active")
  modelUsed     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// Curated tools/resources library.
model ToolboxResource {
  id                String   @id @default(cuid())
  title             String
  url               String   @unique
  resourceType      String   @default("tool")
  category          String   @default("general")
  platform          String?
  useCase           String?
  description       String   @default("")
  whyUseful         String?
  tags              String   @default("[]")
  xValueScore       Int      @default(0)
  sourceReliability String   @default("medium")
  contentFormat     String?
  lastCheckedAt     DateTime?
  linkStatus        String?  @default("unknown") // alive | dead | unknown
  isFavorite        Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  // Toolbox list query filters by isActive (+ optional category) and orders by
  // favorite/score. Composite index keeps the bucketed/lazy queries off a full
  // table scan as the catalog grows.
  @@index([isActive, category])
}

// Production-ready prompt library (seeded from static JSON + user additions).
model PromptTemplate {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  category   String   @default("general")
  useCase    String?
  promptText String
  lang       String   @default("tr")
  tags       String   @default("[]")
  source     String   @default("seed") // seed | user
  createdAt  DateTime @default(now())
}

// ── Anahtar Kelime Kütüphanesi (IA v2) ── Tasarım-prompt anahtar kelimeleri;
// TR/EN çift + (RU/JA/ZH/KO e-ticaret kategorilerinde) yerel-dil terim.
// scripts/import-keywords.ts ile scripts/data/keywords.txt'den idempotent seed.
model KeywordEntry {
  id        String   @id @default(cuid())
  slug      String   @unique // kategori-termEn kebab
  category  String
  termTr    String
  termEn    String
  termLocal String? // yalnız yerel-dil kolonu olan kategorilerde
  tags      String   @default("[]")
  source    String   @default("seed") // seed | user
  createdAt DateTime @default(now())

  @@index([category])
}

// Prompt formülleri (F-1..F-50): şablon + örnek prompt listesi.
model PromptFormula {
  id           String   @id @default(cuid())
  code         String   @unique // F-1, F-22, F-LOCAL-2...
  name         String
  pattern      String // ör. "style + industry"
  examplesJson String   @default("[]")
  category     String   @default("general")
  createdAt    DateTime @default(now())
}

// AI model rankings snapshot (static fallback + optional live fetch).
model AiModelSnapshot {
  id           String   @id @default(cuid())
  snapshotDate String   @unique // YYYY-MM-DD
  rankingsJson String   @default("[]")
  source       String   @default("static")
  createdAt    DateTime @default(now())
}

// Daily aggregated digest shown on the morning dashboard.
model DailyDigest {
  id          String   @id @default(cuid())
  date        String   @unique // YYYY-MM-DD (Europe/Istanbul)
  newsSummary String   @default("")
  repoSummary String   @default("")
  aiTips      String   @default("")
  modelUsed   String?
  costUsd     Float    @default(0)
  createdAt   DateTime @default(now())
}

// ── YouTube Fırsat Motoru (Faz C) — global veri, Account'a relation yok (NewsItem deseni) ──

// Rakip/keşif kanalları. Count alanları Float: Int32 viewCountTotal'da taşar.
model YtChannel {
  id                String    @id @default(cuid())
  channelId         String    @unique // UC... (Data API channel id)
  handle            String              // @handle (kanonik, '@' dahil)
  title             String    @default("")
  subscriberCount   Int       @default(0)
  videoCount        Int       @default(0)
  viewCountTotal    Float     @default(0) // Int32 overflow → Float
  uploadsPlaylistId String    @default("") // UU... contentDetails.relatedPlaylists.uploads
  category          String    @default("global") // ai_haber | kodlama | ai_tips | tasarim | yasam | global
  isCompetitor      Boolean   @default(true)
  discoveredFrom    String    @default("seed") // seed | discovery | manual
  enabled           Boolean   @default(true)
  rollingMedianVpd  Float     @default(0) // 90 günlük medyan views/day (sync yazar)
  lastSyncedAt      DateTime?
  errorCount        Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  videos YtVideo[]

  @@index([enabled, isCompetitor])
  @@index([category])
}

// Tek tek videolar + deterministik outlier skoru (LLM'siz sync yazar).
model YtVideo {
  id           String    @id @default(cuid())
  videoId      String    @unique
  channelId    String // FK → YtChannel.channelId
  channel      YtChannel @relation(fields: [channelId], references: [channelId])
  title        String    @default("")
  description  String    @default("")
  publishedAt  DateTime?
  durationSec  Int       @default(0)
  isShort      Boolean   @default(false) // durationSec <= 60
  viewCount    Float     @default(0) // Float: taşma koruması
  likeCount    Float     @default(0)
  commentCount Float     @default(0)
  viewsPerDay  Float     @default(0)
  outlierScore Float     @default(0)
  likeRatio    Float     @default(0) // likeCount / viewCount
  status       String    @default("new") // new | briefed | dismissed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  briefs YtBrief[]

  @@index([outlierScore])
  @@index([status])
  @@index([channelId, publishedAt])
}

// On-demand üretilen tam Türkçe prodüksiyon briefi (5-aşama konsey çıktısı).
model YtBrief {
  id                      String   @id @default(cuid())
  videoId                 String // FK → YtVideo.videoId
  video                   YtVideo  @relation(fields: [videoId], references: [videoId])
  status                  String   @default("draft") // draft | liked | edited | recorded | dismissed
  pillar                  String   @default("")
  titleVariantsJson       String   @default("[]")
  thumbnailConcept        String   @default("")
  seoDescription          String   @default("")
  hookScript              String   @default("") // ilk 30sn kelime kelime
  fullScript              String   @default("") // bölüm bölüm TAM konuşma metni
  outlineJson             String   @default("[]") // [{heading,targetSec,talkingPoints}]
  differentiationAnalysis String   @default("")
  editingNotes            String   @default("")
  shootingNotes           String   @default("")
  transcriptUsed          Boolean  @default(false)
  sourceTranscript        String   @default("")
  modelUsed               String   @default("")
  costUsd                 Float    @default(0)
  editedScript            String?
  feedbackNote            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status])
  @@index([videoId])
}

// ── Instagram Yorumlar (Faz D) — global veri, Account'a relation YOK (Yt deseni) ──

model IgMedia {
  id           String    @id @default(cuid())
  mediaId      String    @unique // Graph API media id
  caption      String    @default("")
  mediaType    String    @default("") // IMAGE | VIDEO | CAROUSEL_ALBUM | REELS
  permalink    String    @default("")
  postedAt     DateTime? // timestamp'ten
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments IgComment[]

  @@index([postedAt])
}

model IgComment {
  id               String    @id @default(cuid())
  commentId        String    @unique
  mediaId          String // FK → IgMedia.mediaId
  media            IgMedia   @relation(fields: [mediaId], references: [mediaId])
  parentCommentId  String? // null = üst yorum; doluysa yanıt
  username         String    @default("")
  text             String    @default("")
  trText           String    @default("") // Türkçe çeviri (classify yazar)
  lang             String    @default("") // ISO kodu (tr/en/..)
  intent           String    @default("") // soru | övgü | eleştiri | istek | spam | diğer
  intentConfidence Float     @default(0)
  sentiment        String    @default("") // pozitif | nötr | negatif
  priority         Int       @default(0) // 0-100
  status           String    @default("new") // new | analyzed | drafted | replied | ignored
  analysisJson     String    @default("{}")
  postedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  drafts IgReplyDraft[]

  @@index([status])
  @@index([priority])
  @@index([mediaId])
}

model IgReplyDraft {
  id           String    @id @default(cuid())
  commentId    String // FK → IgComment.commentId
  comment      IgComment @relation(fields: [commentId], references: [commentId])
  variant      Int       @default(0) // 0..2
  textTr       String    @default("")
  textOriginal String? // yorumcunun dilinde (yalnız yabancı yazarlar)
  tone         String    @default("")
  status       String    @default("draft") // draft | edited | sent | dismissed
  editedText   String?
  riskWarning  Boolean   @default(false) // eleştiri risk-lens safety<40
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([commentId])
  @@index([status])
}

// DB-tabanlı kimlik deposu. KRİTİK: Vercel env runtime'da değişmez, bu yüzden
// yenilenebilir Meta token BURADA tutulur → refresh redeploy'suz. Okuma: DB → env.
model IntegrationCredential {
  id        String    @id @default(cuid())
  key       String    @unique // örn. "meta_access_token"
  value     String
  expiresAt DateTime?
  meta      String    @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ── Instagram DM + İstatistikler (Faz E) — global veri, Account relation YOK ──

model IgConversation {
  id                  String      @id @default(cuid())
  conversationId      String      @unique // Graph API thread/conversation id
  participantId       String      @default("") // karşı tarafın from.id'si
  participantUsername String      @default("")
  lastMessageAt       DateTime?
  rollingSummary      String      @default("") // >10 mesajda cheapWriter özeti
  lastSyncedAt        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  messages IgMessage[]

  @@index([lastMessageAt])
}

model IgMessage {
  id             String         @id @default(cuid())
  messageId      String         @unique
  conversationId String // FK → IgConversation.conversationId
  conversation   IgConversation @relation(fields: [conversationId], references: [conversationId])
  fromMe         Boolean        @default(false) // true = bizim gönderdiğimiz
  text           String         @default("")
  trText         String         @default("") // Türkçe çeviri (translate yazar)
  lang           String         @default("") // ISO kodu
  status         String         @default("new") // new | translated | drafted
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([conversationId])
  @@index([status])
}

model IgDmDraft {
  id             String    @id @default(cuid())
  conversationId String // FK → IgConversation.conversationId
  messageId      String? // taslağın yanıtladığı son gelen mesaj
  variant        Int       @default(0) // 0..1
  textTr         String    @default("")
  textOriginal   String? // karşı tarafın dilinde (yabancı yazarlar)
  tone           String    @default("")
  status         String    @default("draft") // draft | edited | sent | dismissed
  editedText     String?
  riskWarning    Boolean   @default(false) // DM risk-lens safety<40
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([conversationId])
  @@index([status])
}

model IgInsightSnapshot {
  id              String   @id @default(cuid())
  date            String   @unique // YYYY-MM-DD (Europe/Istanbul) → günde 1 idempotent
  followerCount   Int      @default(0)
  reach           Int      @default(0)
  views           Int      @default(0) // impressions↔views drift normalize
  accountsEngaged Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  saves           Int      @default(0)
  shares          Int      @default(0)
  topMediaJson    String   @default("[]") // en iyi medyalar (reach desc)
  seriesJson      String   @default("[]") // carousel seri performans sıralaması
  rawJson         String   @default("{}") // ham insight — drift teşhisi
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── CemOS Learn (Faz L) — eğitici YouTube videosu → kaynaklandırılmış kalıcı
// öğrenme. Global veri, Account relation YOK (Yt/News deseni). JSON = String
// kolonu (safeJsonParse). Tamamı additive; mevcut modeller dokunulmaz. Tek
// kullanıcı: userId yalnız ileri-uyum (RLS yok, auth yok). LEARN_ENABLED flag'i
// arkasında çalışır.

// Eklenen kaynak (şu an yalnız YouTube). @@unique([kind, externalId]) →
// aynı video iki kez eklenince yeni kayıt değil, mevcut kaynak döner (idempotent).
model LearnSource {
  id           String   @id @default(cuid())
  userId       String? // ileri-uyum scope; null = tek kullanıcı
  kind         String   @default("youtube") // youtube | url | text (gelecek)
  externalId   String // YouTube videoId
  url          String
  title        String   @default("")
  channelTitle String   @default("")
  durationSec  Int      @default(0)
  lang         String?
  metaJson     String   @default("{}") // ham metadata snapshot
  status       String   @default("new") // new | processing | ready | failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transcript LearnTranscript?
  packs      LearnPack[]
  jobs       LearnProcessingJob[]

  @@unique([kind, externalId])
  @@index([status])
}

// Ham transkript (zaman-kodlu segmentler + düz metin). Kaynak başına bir tane.
model LearnTranscript {
  id           String      @id @default(cuid())
  sourceId     String      @unique
  source       LearnSource @relation(fields: [sourceId], references: [id])
  provider     String      @default("innertube") // innertube | timedtext | supadata | gemini | manual
  lang         String?
  segmentsJson String      @default("[]") // [{startSec,endSec,text}] chunk öncesi ham
  fullText     String      @default("")
  charCount    Int         @default(0)
  createdAt    DateTime    @default(now())

  chunks LearnChunk[]
}

// Zaman-kodlu chunk (grounding birimi). idx sıralı; sectionIdx → section synthesis.
model LearnChunk {
  id           String          @id @default(cuid())
  transcriptId String
  transcript   LearnTranscript @relation(fields: [transcriptId], references: [id])
  sourceId     String // sorgu kolaylığı için düz kolon
  idx          Int // 0-tabanlı sıra
  startSec     Float           @default(0)
  endSec       Float           @default(0)
  text         String
  sectionIdx   Int             @default(0) // map-reduce gruplaması
  createdAt    DateTime        @default(now())

  @@unique([sourceId, idx])
  @@index([sourceId, sectionIdx])
}

// Üretilen Learning Pack. @@unique([sourceId, pipelineVersion]) → cache anahtarı:
// aynı transkript + aynı versiyon yeniden işlenmez (gereksiz LLM harcaması yok).
model LearnPack {
  id              String      @id @default(cuid())
  sourceId        String
  source          LearnSource @relation(fields: [sourceId], references: [id])
  pipelineVersion String      @default("")
  promptVersion   String      @default("")
  status          String      @default("draft") // draft | qa_pending | ready | qa_failed
  category        String      @default("diger") // yapay_zeka | kisisel_gelisim | ... (slug)
  summaryL1       String      @default("") // 30sn / tek cümle
  summaryL2       String      @default("") // yönetici özeti
  summaryL3       String      @default("") // bölüm bölüm
  notesJson       String      @default("[]") // yapılandırılmış not ağacı (birim okuma)
  qaReportJson    String      @default("{}") // grounding coverage, flagged, verdict
  masteryScore    Float       @default(0) // kavramlardan toplanan 0..100
  modelUsed       String      @default("")
  costUsd         Float       @default(0)
  warningsJson    String      @default("[]")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  concepts LearnConcept[]
  items    LearnItem[]

  @@unique([sourceId, pipelineVersion])
  @@index([status])
}

// Çıkarılan kavram. groundingJson kanıt bağı; masteryScore review-driven.
model LearnConcept {
  id            String    @id @default(cuid())
  packId        String
  pack          LearnPack @relation(fields: [packId], references: [id])
  label         String
  definition    String    @default("")
  importance    Int       @default(50) // 0..100
  groundingJson String    @default("[]") // [{chunkIdx, support?}]
  masteryScore  Float     @default(0) // kavram-bazlı mastery (review yazar)
  createdAt     DateTime  @default(now())

  items LearnItem[]

  @@index([packId])
}

// Flashcard / quiz item'ı. groundingType: source_supported | external_context |
// inference | uncertain. correctIdx yalnız quiz_mcq'da dolu.
model LearnItem {
  id            String        @id @default(cuid())
  packId        String
  pack          LearnPack     @relation(fields: [packId], references: [id])
  conceptId     String?
  concept       LearnConcept? @relation(fields: [conceptId], references: [id])
  kind          String // flashcard | quiz_mcq
  front         String        @default("") // flashcard ön / quiz kök
  back          String        @default("") // flashcard arka / cevap gerekçesi
  optionsJson   String        @default("[]") // quiz şıkları
  correctIdx    Int? // quiz doğru şık indeksi
  difficulty    Int           @default(2) // 1..5 (soru seçimi)
  groundingType String        @default("source_supported")
  groundingJson String        @default("[]") // [{chunkIdx}]
  createdAt     DateTime      @default(now())

  schedule LearnReviewSchedule?
  attempts LearnReviewAttempt[]

  @@index([packId, kind])
}

// Aralıklı tekrar zamanlaması. dueAt @index → "şimdi due" sorgusu.
model LearnReviewSchedule {
  id             String    @id @default(cuid())
  itemId         String    @unique
  item           LearnItem @relation(fields: [itemId], references: [id])
  ladderStep     Int       @default(0) // [1,3,7,14,30] gün ladder indeksi
  intervalDays   Int       @default(1)
  ease           Float     @default(2.5) // FSRS-lite stability proxy
  dueAt          DateTime
  lastReviewedAt DateTime?
  lapses         Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([dueAt])
}

// Tek tekrar denemesi (grade 0=again 1=hard 2=good 3=easy).
model LearnReviewAttempt {
  id         String    @id @default(cuid())
  itemId     String
  item       LearnItem @relation(fields: [itemId], references: [id])
  grade      Int
  correct    Boolean   @default(false)
  responseMs Int       @default(0)
  reviewedAt DateTime  @default(now())

  @@index([itemId, reviewedAt])
}

// Resumable işleme job'ı. currentStage + status ile artımlı ilerler; heartbeatAt
// lease (bayat → cron sweep devralır). @@unique([sourceId, pipelineVersion]) →
// kaynak+versiyon başına tek aktif job (idempotent).
model LearnProcessingJob {
  id              String      @id @default(cuid())
  sourceId        String
  source          LearnSource @relation(fields: [sourceId], references: [id])
  currentStage    String      @default("source_created")
  status          String      @default("pending") // pending | running | done | failed
  attempts        Int         @default(0) // mevcut aşama retry sayacı (cap, tüm job değil)
  lastError       String?
  stageStateJson  String      @default("{}") // kısmi ilerleme (örn. biten section'lar)
  pipelineVersion String      @default("")
  startedAt       DateTime?
  finishedAt      DateTime?
  heartbeatAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([sourceId, pipelineVersion])
  @@index([status, currentStage])
}

// ── Content Intelligence (Eden-inspired) — Faz CI ──
// Tamamı additive; mevcut modeller DOKUNULMAZ. Global veri (Account relation YOK,
// Yt/News/Ig deseni) — hesap kapsamı plain `accountId` String + index ile. JSON =
// String kolonu (safeJsonParse). Soft-provenance: ContentItem mevcut tablolara FK
// eklemeden originTable+originId ile bağlanır → tek CREATE TABLE, kolay rollback.

// Birleşik kanonik içerik birimi. Tüm platform kaynakları (X/IG/YT/News/Repo/manuel)
// bu modele normalize olur. @@unique([platform, externalId]) → idempotent dedup:
// aynı kaynak iki kez işlenince yeni satır değil, mevcut döner.
model ContentItem {
  id              String    @id @default(cuid())
  platform        String // x | instagram | youtube | news | repo | manual
  externalId      String // ham platform id (prefix'siz)
  canonicalUrl    String? // tekilleştirme yardımcı anahtarı
  sourceType      String    @default("external") // external | own | manual
  // Soft-provenance: hangi mevcut tablodan türedi (FK eklemeden lineage).
  originTable     String? // "SourcePost" | "NewsItem" | "YtVideo" | "IgMedia" | "RepoRadarItem"
  originId        String? // origin tablosundaki id
  creatorId       String? // FK → Creator (Faz 3); şimdilik null olabilir
  creator         Creator?  @relation(fields: [creatorId], references: [id])
  contentType     String    @default("post") // post | video | article | repo | thread
  format          String    @default("") // x_single | x_thread | ig_reel | ig_carousel | ig_static | yt_long | yt_short | news_article | repo
  title           String    @default("")
  body            String    @default("")
  transcript      String    @default("")
  language        String?
  author          String    @default("") // Creator bağlanmadan önceki görünen yazar/handle
  mediaUrlsJson   String    @default("[]") // [url, ...]
  metricsJson     String    @default("{}") // { likes, retweets, views, comments, shares, stars, ... }
  rawMetadataJson String    @default("{}")
  ingestionStatus String    @default("normalized") // normalized | enriched | failed
  analysisStatus  String    @default("pending") // pending | analyzed | failed
  publishedAt     DateTime?
  firstSeenAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  outlierScores ContentOutlierScore[]
  boardItems    BoardItem[]
  ideaSources   IdeaSource[]
  embedding     ContentEmbedding?

  @@unique([platform, externalId])
  @@index([platform, format])
  @@index([creatorId])
  @@index([analysisStatus])
  @@index([publishedAt])
  @@index([originTable, originId])
}

// İçerik üreticisi (platform hesaplarından AYRI — Eden ilkesi). Bir creator çoklu
// platform profiline sahip olabilir; şimdilik platform+handle ile tekil.
model Creator {
  id          String   @id @default(cuid())
  platform    String // x | instagram | youtube
  handle      String // @handle veya kanal id (kanonik)
  displayName String   @default("")
  followers   Float    @default(0) // Float: Int32 taşma koruması
  metaJson    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentItems ContentItem[]
  baselines    CreatorBaseline[]

  @@unique([platform, handle])
  @@index([platform])
}

// Creator × format medyan performansı (outlier paydası). Platform+format başına
// bir baseline; window kapanışında yeniden hesaplanır (versiyonlanır).
model CreatorBaseline {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  platform    String
  format      String // x_single | x_thread | ig_reel | ...
  metric      String   @default("engagement") // engagement | views | likes
  medianValue Float    @default(0)
  sampleSize  Int      @default(0)
  windowDays  Int      @default(30)
  version     Int      @default(1)
  computedAt  DateTime @default(now())

  @@unique([creatorId, format, metric])
  @@index([platform, format])
}

// İçerik birimi başına açıklanabilir outlier skoru. multiplier = metric / medyan.
model ContentOutlierScore {
  id              String      @id @default(cuid())
  contentItemId   String
  contentItem     ContentItem @relation(fields: [contentItemId], references: [id])
  metric          String      @default("engagement")
  metricValue     Float       @default(0)
  baselineMedian  Float       @default(0)
  multiplier      Float       @default(0) // metricValue / baselineMedian
  sampleSize      Int         @default(0)
  insufficient    Boolean     @default(false) // min örneklem altı → güvenilmez
  explanationJson String      @default("{}") // { window, sampleSize, formula, ... }
  version         Int         @default(1)
  computedAt      DateTime    @default(now())

  @@unique([contentItemId, metric])
  @@index([multiplier])
}

// ── Boards / Swipe-file ── (Kütüphane savedTweets → kalıcı boards)
// Hesap-kapsamlı plain accountId (FK yok, global desen).
model Board {
  id          String    @id @default(cuid())
  accountId   String? // null = paylaşılan/genel board
  name        String
  description String    @default("")
  icon        String    @default("")
  position    Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections BoardSection[]
  items    BoardItem[]

  @@index([accountId])
}

model BoardSection {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id])
  name      String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  items BoardItem[]

  @@index([boardId])
}

// Board içindeki birim: kanonik ContentItem referansı VEYA serbest (url/not/görsel).
model BoardItem {
  id            String        @id @default(cuid())
  boardId       String
  board         Board         @relation(fields: [boardId], references: [id])
  sectionId     String?
  section       BoardSection? @relation(fields: [sectionId], references: [id])
  contentItemId String? // varsa kanonik içerik
  contentItem   ContentItem?  @relation(fields: [contentItemId], references: [id])
  itemType      String        @default("content") // content | url | image | note | idea | draft
  title         String        @default("")
  url           String        @default("")
  note          String        @default("")
  metaJson      String        @default("{}")
  position      Int           @default(0)
  createdAt     DateTime      @default(now())

  @@index([boardId])
  @@index([sectionId])
  @@index([contentItemId])
}

// ── Idea ── kaynak + voice'a bağlı, özgünleştirilmiş fikir (Draft'tan ÖNCE).
// QueueItem = Draft olarak korunur; Idea onun üstünde yeni katman.
model Idea {
  id                 String   @id @default(cuid())
  accountId          String // hangi sosyal hesap için
  title              String   @default("")
  angle              String   @default("")
  hook               String   @default("")
  bodyOutline        String   @default("")
  platform           String   @default("x")
  format             String   @default("")
  objective          String   @default("") // save | reply | follow | profile_visit
  whyNow             String   @default("")
  status             String   @default("new") // new | drafted | dismissed
  voiceProfileId     String? // Faz 4 voice; şimdilik null
  scoresJson         String   @default("{}") // opportunity score breakdown
  // Lineage: hangi reverse-engineer/transformation'dan türedi.
  transformationType String? // reverse_engineer | boost | manual | brief
  promptVersion      String   @default("")
  modelUsed          String   @default("")
  costUsd            Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sources IdeaSource[]

  @@index([accountId, status])
  @@index([platform])
}

// Idea ↔ kaynak ContentItem köprüsü (provenance; bir idea çoklu kaynak alıntılar).
model IdeaSource {
  id            String      @id @default(cuid())
  ideaId        String
  idea          Idea        @relation(fields: [ideaId], references: [id])
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  role          String      @default("primary") // primary | supporting
  createdAt     DateTime    @default(now())

  @@unique([ideaId, contentItemId])
  @@index([contentItemId])
}

// ── Voice & Visual Identity (Faz CI-4) ── Hardcoded prompts.ts → DB profilleri.
// Hesap-kapsamlı plain accountId. Array alanlar JSON String (proje deseni).
model VoiceProfile {
  id                String   @id @default(cuid())
  accountId         String
  name              String   @default("default")
  mission           String   @default("")
  pointOfView       String   @default("")
  coreIdeasJson     String   @default("[]")
  audience          String   @default("")
  personality       String   @default("")
  vocabularyJson    String   @default("[]")
  toneTagsJson      String   @default("[]")
  rhythm            String   @default("")
  formatHabitsJson  String   @default("[]")
  preferredJson     String   @default("[]") // preferred patterns
  avoidJson         String   @default("[]") // avoid patterns
  anchorStories     String   @default("")
  writingSamples    String   @default("")
  notes             String   @default("")
  // Sprint 4 (CONTENT-ENGINE §5.2): mikro-stil kolonları (additive — VoiceProfile
  // = Voice DNA; yeni ses tablosu YOK).
  sentenceLength      String @default("")
  formality           String @default("")
  directness          String @default("")
  hookType            String @default("")
  ctaType             String @default("")
  emojiPolicy         String @default("")
  punctuationStyle    String @default("")
  claimEvidencePolicy String @default("")
  mode              String   @default("personal") // personal | brand | client
  version           Int      @default(1)
  isActive          Boolean  @default(true)
  sourceAttribution String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId, isActive])
}

model VisualStyleProfile {
  id                 String   @id @default(cuid())
  accountId          String
  name               String   @default("default")
  brandColorsJson    String   @default("[]")
  typography         String   @default("")
  layoutPatternsJson String   @default("[]")
  aspectRatiosJson   String   @default("[]")
  textDensity        String   @default("")
  headlineLength     String   @default("")
  imageStyle         String   @default("")
  motifsJson         String   @default("[]")
  ctaStyle           String   @default("")
  forbiddenJson      String   @default("[]")
  referencesJson     String   @default("[]")
  isActive           Boolean  @default(true)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accountId, isActive])
}

// ── Performance & Learning (Faz CI-6) ── Published Post ≠ ContentItem (Eden ilkesi).
model PublishedPost {
  id               String   @id @default(cuid())
  accountId        String
  draftQueueItemId String? // hangi QueueItem'dan yayımlandı (provenance, FK yok)
  ideaId           String? // köken idea (provenance)
  platform         String   @default("x")
  externalId       String? // platform post id
  url              String   @default("")
  content          String   @default("")
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  snapshots PerformanceSnapshot[]

  @@index([accountId, publishedAt])
  @@index([platform])
}

// Zaman-pencereli metrik anlık görüntüsü (1h/6h/24h/3d/7d/30d). predicted↔actual kalibrasyonu.
model PerformanceSnapshot {
  id              String        @id @default(cuid())
  publishedPostId String
  publishedPost   PublishedPost @relation(fields: [publishedPostId], references: [id])
  window          String // 1h | 6h | 24h | 3d | 7d | 30d
  metricsJson     String        @default("{}")
  normalizedScore Float         @default(0)
  capturedAt      DateTime      @default(now())

  @@unique([publishedPostId, window])
  @@index([publishedPostId])
}

// ── Viral Kütüphane (IA v2) ── Yıldızlanan viral tweetler; eskiden yalnız
// localStorage'daydı (Zustand savedTweets). id = tweet id → idempotent upsert;
// ViralLibraryTab mount'ında tek-seferlik localStorage göçü bunu kullanır.
model SavedViralTweet {
  id           String   @id // tweet id
  channel      String? // grafikcem | maskulenkod
  authorHandle String
  text         String
  likeCount    Int      @default(0)
  retweetCount Int      @default(0)
  viewCount    Int      @default(0)
  viralScore   Int      @default(0)
  url          String   @default("")
  source       String   @default("")
  mediaUrl     String?
  mediaType    String?
  note         String   @default("")
  tags         String   @default("[]")
  savedAt      DateTime @default(now())

  @@index([savedAt])
  @@index([channel])
}

// ── Semantic Discover (Faz CI-3) ── Searchable document embedding.
// v1: JSON vektör + JS cosine (repo'nun mevcut vector-memory deseni). pgvector =
// sonraki perf optimizasyonu (extension + Unsupported("vector")).
model ContentEmbedding {
  id            String      @id @default(cuid())
  contentItemId String      @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  model         String      @default("")
  dim           Int         @default(0)
  embeddingJson String      @default("[]") // Float[] JSON
  searchableDoc String      @default("") // title+body+transcript+tags birleşimi
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([contentItemId])
}

// ── Memory Foundation (Sprint 3, FINAL-MEMORY-SPEC §4) ── Tier-2 relational
// truth. Additive-only; DELETE asla (supersede zinciri). Identity hafızası
// yavaş + insan-onaylı; performance hafızası hızlı + decay'li.
model MemoryFact {
  id                String    @id @default(cuid())
  accountHandle     String? // "grafikcem" | "maskulenkod"; null = global (nadir)
  type              String // "preference" | "semantic" | "procedural"
  statement         String // atomik tek cümle, Türkçe
  embeddingJson     String? // Float[] JSON — recall için opsiyonel
  embeddingModel    String? // §7: model+dims etiketi zorunlu (space karışmaz)
  embeddingDims     Int?
  confidence        Float     @default(0) // §4.1 formülü
  evidenceCount     Int       @default(0)
  sourceProvenance  String // "operator" | "own_metric" | "self_judge" | "external"
  status            String    @default("proposed") // proposed | active | superseded | rejected
  tValid            DateTime  @default(now())
  tInvalid          DateTime? // supersede anında set; DELETE asla
  supersedesId      String? // versiyon zinciri (rollback bunu takip eder)
  createdBy         String // "operator" | "consolidation" | "feedback_pipeline"
  approvedBy        String? // identity promotion'da zorunlu
  decayHalfLifeDays Int? // perf-leaning fact'lerde; identity'de null (≈∞)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountHandle, status])
  @@index([type, status])
}

// Per-account identity/procedural yazım DNA'sı (human-gated güncelleme).
model CaptionDna {
  id               String   @id @default(cuid())
  accountHandle    String   @unique
  openingHookTypes String   @default("[]") // string[] JSON
  lengthRange      String   @default("{}") // {min,max,median} JSON
  sentenceRhythm   String?
  emojiPolicy      String   @default("none") // "none" | "sparse" | "free"
  ctaStyle         String?
  lineBreakPattern String?
  signaturePhrases String   @default("[]") // string[] JSON
  forbiddenPhrases String   @default("[]") // string[] JSON
  toneVector       String? // number[] JSON
  languageRegister String   @default("casual") // "formal" | "casual" | "argo_ok"
  confidence       Float    @default(0)
  evidenceCount    Int      @default(0)
  provenance       String   @default("operator") // MemoryFact ile aynı enum
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt
}

// ── Series DNA (Sprint 4, CONTENT-ENGINE §5.1 — report 09 §10.1 verbatim) ──
// FK-free accountId + JSON-string dizileri (VoiceProfile/VisualStyleProfile
// deseniyle birebir). İlk seri: Best AI Tools (D5).
model SeriesProfile {
  id                      String   @id @default(cuid())
  accountId               String
  seriesKey               String // "best_ai_tools" | "premium_colors" ...
  name                    String   @default("") // "Best AI Tools"
  platform                String   @default("instagram") // instagram | x
  // WHY
  purpose                 String   @default("")
  audience                String   @default("")
  objective               String   @default("") // save | follow | share | profile_visit
  // STRUCTURE
  format                  String   @default("carousel") // carousel | single | reel | thread
  slideCountRange         String   @default("") // "6-8"
  coverFormula            String   @default("") // the hook/cover template
  slideArchetypesJson     String   @default("[]") // ["cover","tool+why","proof","CTA"]
  hierarchyNotes          String   @default("")
  variableElementsJson    String   @default("[]") // her postta DEĞİŞMESİ zorunlu öğeler
  ctaFormula              String   @default("")
  // VISUAL (link, don't duplicate)
  visualStyleProfileId    String? // -> VisualStyleProfile
  // CAPTION (link, don't duplicate)
  voiceProfileId          String? // -> VoiceProfile
  captionDnaJson          String   @default("{}") // seri-özel caption override'ları
  hashtagDnaJson          String   @default("[]")
  // ANTI-REPETITION / MEMORY
  pastTopicsJson          String   @default("[]")
  bannedRepetitionJson    String   @default("[]")
  // QUALITY
  productionChecklistJson String   @default("[]")
  evaluationRubricJson    String   @default("[]")
  learnedRulesJson        String   @default("[]") // PRELUDE-inferred, operator-onaylı
  // GOVERNANCE
  promptVersion           String   @default("v1")
  isActive                Boolean  @default(true)
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([accountId, isActive])
  @@index([seriesKey])
}

// ── Website Verifier (Sprint 4, CONTENT-ENGINE §4.1) ── Tier-1 HTTP kanıtı.
// Deterministik, LLM'siz; dossier'ler verificationId ile bu satıra bağlanır.
model WebsiteVerification {
  id            String   @id @default(cuid())
  url           String
  finalUrl      String   @default("")
  opens         Boolean  @default(false)
  redirectChain String   @default("[]") // string[] JSON
  evidenceJson  String   @default("{}") // VerificationEvidence JSON
  checkedAt     DateTime @default(now())
  expiry        DateTime // +30g; geçmişse "yeniden doğrula" rozeti
  createdAt     DateTime @default(now())

  @@index([url, checkedAt])
  @@index([expiry])
}

// Per-account (+ opsiyonel seri) hashtag DNA'sı — performance-leaning, decay'li.
model HashtagDna {
  id                String   @id @default(cuid())
  accountHandle     String
  seriesId          String? // → SeriesProfile (CONTENT-ENGINE spec'i, ileri sprint)
  coreTags          String   @default("[]") // string[] JSON
  rotatingTags      String   @default("[]") // string[] JSON
  tagCountRange     String   @default("{}") // {min,max} JSON
  placement         String   @default("end") // "inline" | "end" | "first_comment"
  casing            String?
  bannedTags        String   @default("[]") // string[] JSON
  perTagPerformance String   @default("{}") // {tag:{avgEngagement,n}} JSON
  confidence        Float    @default(0)
  evidenceCount     Int      @default(0)
  decayHalfLifeDays Int      @default(45)
  updatedAt         DateTime @updatedAt

  @@unique([accountHandle, seriesId])
}
