# ══════════════════════════════════════════════════════════════════════════
# CemOS (XAgent) — env template. GERÇEK değerleri .env.local'a yaz (git'e girmez).
# Bu dosya commit'lenir; tüm anahtarları placeholder ile listeler.
# ══════════════════════════════════════════════════════════════════════════

# ── ZORUNLU (uygulama çalışması için) ──
# Neon Postgres bağlantısı (Prisma + uygulama).
DATABASE_URL=
# LLM çağrıları (taslak üretimi + haber çeviri/skorlama + digest + toolbox enrich).
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=CemOS XAgent
# X/Twitter veri çekme (SocialData.tools).
SOCIALDATA_API_KEY=
# Vercel cron endpoint'lerini korur (önerilen — set edilmezse endpoint açık kalır).
CRON_SECRET=
# IntegrationCredential.value (Meta token vb.) disk şifrelemesi (AES-256-GCM, SEC-03).
# 32-byte base64 anahtar üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set edilmezse credential'lar düz metin yazılır (yalnız local/test için).
CREDENTIAL_ENC_KEY=

# ── Tek-operatör erişim kapısı (Faz 1A · ADR-013/017) ──
# Operatör parolasının scrypt hash'i (düz parola DEĞİL). Üret:
#   npx tsx scripts/hash-access-password.ts "guclu-parolan"
# Prod'da zorunlu; yoksa proxy fail-closed /giris?setup=1 gösterir. Dev'de opsiyonel (kapı kapalı).
ACCESS_PASSWORD_HASH=
# Session cookie HMAC anahtarı (parola sırrından AYRI). Üret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Model override'ları (opsiyonel; boş bırak = katalog default'ları) ──
# Faz 2E: örnek slug'lar model-config.ts default'larıyla eşitlendi (stale
# deepseek-chat:free / claude-sonnet-4.5 örnekleri düzeltildi).
OPENROUTER_CHEAP_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_JUDGE_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-5
ENABLE_PREMIUM_MODEL=false

# ── Davranış toggle'ları (opsiyonel; boş bırak = kod default'u) ──
# Model profili: "fast" | "balanced" | "operator_quality".
# operator_quality → cheap/judge'ı gemini/claude'a yükseltir (maliyet artar).
MODEL_PROFILE=
# free model'lere izin / konsey jüri adımı / final editör geçişi / LLM kalite-lint.
ENABLE_FREE_MODELS=
ENABLE_JUDGE=
ENABLE_FINAL_EDITOR=
ENABLE_LLM_LINT=
# Haber kaynak toggle'ları.
INCLUDE_RETWEETS=
DISABLE_REDDIT_SOURCE=
# Manuel sync deadline'ları, ms (opsiyonel; default'lar igConfig/ytConfig'de).
YT_SYNC_MANUAL_DEADLINE_MS=
IG_SYNC_MANUAL_DEADLINE_MS=

# ── Tarama limitleri (opsiyonel, default'lar parantezde) ──
SOCIALDATA_DAILY_TWEET_BUDGET=150
SCAN_MAX_TWEETS_PER_SOURCE=10
SCAN_MAX_SOURCES_PER_ACCOUNT=5

# ── Bütçeler ──
# Aylık AI/LLM bütçesi USD (10). Dolunca tarama+üretim otomatik duraklar.
MONTHLY_AI_BUDGET_USD=10
# Harcamayi ayin gunlerine yay (false yalniz kontrollu bakim icin).
AI_BUDGET_PACING_ENABLED=true
# Arka plan haber/mining/memory isleri aylik operasyon butcesinin en fazla %30'unu kullanir.
AI_BACKGROUND_BUDGET_RATIO=0.30
# Core/manual uretim icin arka plan islerinden korunan aylik pay.
AI_MONTHLY_RESERVE_USD=1
# Canli eval harcamasi varsayilan kapali; tek seferlik kosuda ac ve tekrar kapat.
AI_EVAL_SPEND_ENABLED=false
AI_EVAL_MONTHLY_BUDGET_USD=0.50

# ── Faz 2E canlı eval/kürasyon kapıları (ADR-034; default'lar KAPALI) ──
# LLM fırsat kürasyonu (server-side): 1 = açık. Rotasyon marker'ı olmadan yine çalışmaz.
ENABLE_AGENT_CURATION=0
# OpenRouter anahtarı DÖNDÜRÜLDÜĞÜNDE kullanıcı tarafından set edilir (ISO tarih).
# Boşken HİÇBİR canlı OpenRouter çağrısı yapılmaz (2C sızıntı sonrası güvenlik kapisi).
OPENROUTER_KEY_ROTATED_AT=
# İlk canlı curator+thread smoke için açık onay + per-run tavan (≤ 0.50 USD).
PHASE2E_LIVE_EVAL_APPROVED=false
PHASE2E_LIVE_MAX_USD=0
# Ucretsiz /api/v1/key kontrolu icin 5 dakikalik cache.
OPENROUTER_KEY_STATUS_CACHE_MS=300000
# Response cost ile key ledger arasindaki gecici fark icin %20 guvenlik payi.
OPENROUTER_USAGE_SAFETY_MULTIPLIER=1.20
# Toolbox enrichment bir-kerelik bütçesi USD (scripts/enrich-toolbox.ts, 1.5).
TOOLBOX_ENRICH_BUDGET_USD=1.5

# ── Faz 3B canlı Instagram İÇERİK ÜRETİMİ kapıları (ADR-036; default KAPALI) ──
# Eval kapılarından AYRI: eval onayı ürün üretimi onayı DEĞİLDİR.
# Dördü birlikte gerekli; biri eksikse OpenRouter/verifyWebsite çağrısı ve
# ReelDossier/UsageLog/TrainingExample yazımı YAPILMAZ.
INSTAGRAM_GENERATION_ENABLED=false
INSTAGRAM_GENERATION_LIVE_APPROVED=false
# Per-pass toplam tavan (USD); 0 < değer <= 0.50.
INSTAGRAM_GENERATION_MAX_USD=0

# ── Görsel üretimi (fal.ai) ──
# fal.ai API anahtarı. Set edilmezse görsel üretimi prompt-only kalır.
FAL_KEY=
# Model slug. Default = Nano Banana Pro (~$0.15). NB1 = fal-ai/gemini-25-flash-image (~$0.039).
FAL_IMAGE_MODEL=fal-ai/nano-banana-pro
FAL_IMAGE_COST_USD=0.15
# AYLIK fal görsel bütçesi USD — LLM bütçesinden AYRI.
FAL_MONTHLY_BUDGET_USD=10

# ── YouTube Fırsat Motoru ──
# Data API v3 anahtarı (zorunlu; yoksa YouTube sekmesi boş fail-open kalır).
YOUTUBE_API_KEY=
YT_BRIEF_DAILY_LIMIT=3
YT_BRIEF_MONTHLY_BUDGET_USD=2
# Kendi kanal performans öğrenmesi (ytOutcome). Set edilmezse kol no-op.
# Değer = kanal @handle'ı (örn. "@grafikcem").
YT_OWN_CHANNEL_GRAFIKCEM=
YT_OWN_CHANNEL_MASKULENKOD=
# ytOutcome verdict eşikleri (havuz medyanına göre göreli; default 0.5 / -0.5).
YT_OUTCOME_HIGH=
YT_OUTCOME_LOW=

# ── Sürekli öğrenme / cron (hepsi opsiyonel, default'lar parantezde) ──
# Hesap başına günlük mine edilecek post (2). 0 = mining kapalı.
MINING_DAILY_LIMIT=
# Engagement eşikleri: high (15) / low (2). Global fallback.
ENGAGEMENT_HIGH_MIN=
ENGAGEMENT_LOW_MAX=
# Per-account override (2026 araştırma kalibrasyonu, kademeli başlangıç):
# grafikcem ~94K → 300/50, maskulenkod küçük hesap → 60/10.
ENGAGEMENT_HIGH_MIN_GRAFIKCEM=300
ENGAGEMENT_LOW_MAX_GRAFIKCEM=50
ENGAGEMENT_HIGH_MIN_MASKULENKOD=60
ENGAGEMENT_LOW_MAX_MASKULENKOD=10
# IG engagement eşikleri (reach-normalize *1000 ölçek; default high 50 / low 5).
IG_ENGAGEMENT_HIGH=42
IG_ENGAGEMENT_LOW=14
# Cron hesap döngüsü zaman bütçesi, ms (maxDuration*800).
CRON_TIME_BUDGET_MS=
# 06:00 cron'unda haber pipeline'ına ayrılan süre, ms (150000).
NEWS_TIME_BUDGET_MS=
# GitHub Trending repo radarı için (opsiyonel — rate limit artırır).
GITHUB_TOKEN=
# Feed The Goat snapshot token (read-only).
XAGENT_SNAPSHOT_TOKEN=

# ── Ücretsiz X scraper (opsiyonel, SocialData fallback) ──
# "true" ise twitter-scraper logged-out modda denenir.
# GÜVENLİK: login-cookie modu ASLA @grafikcem (verified) hesabıyla kullanılmaz.
X_SCRAPER_ENABLED=

# ── CemOS Learn (YouTube → kalıcı öğrenme motoru, Faz L) ──
# Modül anahtarı. "true" değilse route'lar "disabled" döner, cron sweep no-op,
# Öğren alanında sekme görünmez. Server tarafı gate.
LEARN_ENABLED=
# Client nav gating (build-time inline). Öğren alanında "CemOS Learn" sekmesini
# göstermek için "true" (LEARN_ENABLED ile birlikte set edilmeli).
NEXT_PUBLIC_LEARN_ENABLED=
# Aylık öğrenme LLM bütçesi USD (3). meta.purpose="learn_pack" satırlarından sayılır;
# yt_/diğer bütçelerden AYRI. Dolunca işleme 429 ile duraklar, bütçe yenilenince devam.
LEARN_MONTHLY_BUDGET_USD=3
# Gemini native YouTube transkript (OpenRouter videoyu işleyemez). aistudio.google.com'dan
# ücretsiz key. Set edilmezse youtubei.js + manuel yapıştırma fallback'i kullanılır.
GEMINI_API_KEY=
# Transkript için Gemini modeli (default gemini-2.5-flash; video destekler, ucuz).
GEMINI_TRANSCRIPT_MODEL=gemini-2.5-flash
# Supadata 3rd-party transkript fallback (supadata.ai). Innertube/timedtext Vercel IP'sinde
# bloklu + Gemini bazı videoları PROHIBITED_CONTENT ile reddeder; Supadata gerçek altyazıyı
# kendi altyapısından çeker → ikisini de atlatır. Free tier ~100 istek/ay. Boşsa Gemini+manuel
# fallback sürer. Zincir: innertube → timedtext → supadata → gemini.
SUPADATA_API_KEY=
# Obsidian vault klasör yolu (SADECE local; Node fs). Set'liyse pack hazır olunca
# markdown (video notu + kavram [[notları]]) otomatik buraya yazılır. Boşsa .zip indirme.
# Vercel'de fs ephemeral → set etme. Örn: C:\Users\me\ObsidianVault
OBSIDIAN_VAULT_PATH=

# ── Composio Instagram read köprüsü (Phase 2C · ADR-032) ──
# CemOS runtime, https://connect.composio.dev/mcp MCP endpoint'ine server-side
# bağlanır (Claude Code MCP config'inden BAĞIMSIZ). Tümü SERVER-ONLY; asla
# NEXT_PUBLIC_ prefix'i kullanma. Gerçek değerler yalnız .env.local/Vercel env.
# Composio consumer API key (x-consumer-api-key header'ı). SECRET.
COMPOSIO_CONSUMER_API_KEY=
# Composio'da bağlı Instagram connection'ının id'si — hesap seçimi AÇIK yapılır
# (birden çok bağlantıda "en son kullanılan" sessiz seçimi yok). Secret değildir
# ama client'a/loga koyulmaz.
COMPOSIO_INSTAGRAM_CONNECTED_ACCOUNT_ID=
# Bu Instagram bağlantısının hangi CemOS Account profiline ait olduğu.
# DB'de aktif bir Account.handle olmalı; çözülemezse sync fail-closed durur.
COMPOSIO_INSTAGRAM_ACCOUNT_HANDLE=grafikcem
# Keşfedilen Composio Instagram toolkit sürümü (drift teşhisi; ör. 20260708_00).
COMPOSIO_INSTAGRAM_TOOLKIT_VERSION=
# Instagram read provider seçimi: "auto" (Composio sağlıklıysa Composio, değilse
# işaretli Meta fallback) | "composio" (sessiz fallback YOK) | "meta".
INSTAGRAM_DATA_PROVIDER=auto

# ── Instagram (Meta Graph API, dev mode). Kurulum: docs/META_KURULUM.md ──
# Hepsi set edilmezse Instagram sekmesi "kurulum gerekli" boş kalır (fail-open).
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=
META_PAGE_ID=
# İlk uzun ömürlü (60 gün) token. Yenilemeler DB'ye yazılır; okuma DB → env.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# Aylık IG LLM bütçesi USD (1.5). meta.purpose="ig_*" satırlarından sayılır.
IG_MONTHLY_BUDGET_USD=1.5
